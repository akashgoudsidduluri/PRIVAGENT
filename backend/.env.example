GEMINI_API_KEY=
GROQ_API_KEY=
NAVIGATOR_PROVIDER=groq
# Optional primary-model overrides (defaults: gemini-3.8-flash / openai/gpt-oss-120b)
GEMINI_MODEL=
GROQ_MODEL=
MAX_STEPS=25
MAX_RETRIES=3
TASK_TIMEOUT_S=360
# Off by default: screenshots stay on-device. Set true only if you accept
# sending a rendered page image to the remote model provider.
ALLOW_SCREENSHOTS=false

# DeepAI Gateway (Local OpenAI-compatible gateway for DeepSeek & free models)
DEEPAI_GATEWAY_BASE_URL=http://127.0.0.1:8787/v1
DEEPAI_GATEWAY_KEY=
DEEPAI_GATEWAY_MODEL=deepseek-v4.1-flash
