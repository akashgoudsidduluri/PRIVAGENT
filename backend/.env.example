GEMINI_API_KEY=
GROQ_API_KEY=
NAVIGATOR_PROVIDER=groq
# Encrypted secret store (Task 2): OAuth tokens, OAuth client secrets, LLM
# API keys and runtime keys set via POST /api/llm/config are stored encrypted
# in backend/data/secrets.enc.json (Fernet, key derived via PBKDF2 from a
# master key) — never in plaintext in this file. On first startup after the
# upgrade, any secret values found here are migrated into the store and
# blanked from this file. Client IDs are not secrets and stay here.
# Master key (recommended): set a strong passphrase or a Fernet key here
# (or in the environment). If unset, the backend tries the OS keychain
# (keyring, if installed), else generates backend/data/.master.key (0600) —
# local-only protection, not hardware-backed. Back it up: losing it makes
# every stored secret unrecoverable. Never commit a real value.
PRIVAGENT_MASTER_KEY=
# Local operator auth (Task 1, encrypted since Task 2): required on every
# /api/* route except /api/health. Set a fixed token here, or leave it empty
# and the backend generates one on first startup and stores it encrypted in
# the secret store (the old plaintext backend/data/.local_token file is
# migrated and deleted). Never commit a real value. The web UI prompts for
# it once on first use; print it with:
#   backend/venv/bin/python backend/scripts/print_local_token.py
PRIVAGENT_LOCAL_TOKEN=
# --- Connected Services OAuth (per-user, multi-account) ---
# Register one OAuth app per provider and paste its client ID + secret
# here (or in the Connectors tab Setup form — the secret is then stored
# encrypted, never in this file). Redirect URI for every app:
#   http://localhost:8000/api/connectors/{google,microsoft,slack,github}/callback
# Google Cloud: console.cloud.google.com/apis/credentials (enable Gmail,
# Calendar, Drive APIs). Azure AD: portal.azure.com App registrations.
# Slack: api.slack.com/apps. GitHub: github.com/settings/developers.
# Requested scopes (least-privilege; a user can hold several accounts
# per provider, each row in oauth_connections): Google gmail.modify,
# calendar.events, drive.readonly, drive.file. Microsoft User.Read
# (needed for GET /v1.0/me — the live check and account identity),
# offline_access, Mail.ReadWrite, Calendars.ReadWrite (Outlook is
# read/delete-only; there is no Mail.Send). Slack channels:read,
# channels:history, groups:history, chat:write (bot scopes; private
# channels are listed only if the bot is invited, DMs are not covered).
# GitHub repo — unavoidably broad: no read-only private-repo OAuth
# scope exists. PKCE S256 is sent for Google/Microsoft/GitHub; Slack
# PKCE is deliberately NOT enabled (localhost redirect + bot scopes).
# Slack returns no refresh token unless rotation is on; GitHub OAuth Apps
# issue refresh tokens only when expiring tokens are enabled — those
# reconnect when the token dies. Microsoft disconnect is local-delete
# only (no per-token revoke exists).
PRIVAGENT_GOOGLE_OAUTH_CLIENT_ID=
PRIVAGENT_GOOGLE_OAUTH_CLIENT_SECRET=
PRIVAGENT_MICROSOFT_OAUTH_CLIENT_ID=
PRIVAGENT_MICROSOFT_OAUTH_CLIENT_SECRET=
PRIVAGENT_SLACK_OAUTH_CLIENT_ID=
PRIVAGENT_SLACK_OAUTH_CLIENT_SECRET=
PRIVAGENT_GITHUB_OAUTH_CLIENT_ID=
PRIVAGENT_GITHUB_OAUTH_CLIENT_SECRET=
# Workspace origin the OAuth callback redirects back to after authorize /
# deny (default http://localhost:5173, the Vite dev server). Must stay
# localhost / 127.0.0.1.
PRIVAGENT_WEB_ORIGIN=http://localhost:5173
# Optional primary-model overrides (defaults: gemini-3.8-flash / openai/gpt-oss-120b)
GEMINI_MODEL=
GROQ_MODEL=
# MAX_STEPS is the legacy name for the step cap (default 50); prefer
# PRIVAGENT_MAX_STEPS below — it wins when both are set.
MAX_STEPS=50
MAX_RETRIES=3
TASK_TIMEOUT_S=360
# --- Memory & long-horizon (Task 9) ---
# Step caps: every task gets MAX_STEPS; tasks created with
# long_horizon=true get MAX_LONG_STEPS instead. Compaction writes a
# short summary every COMPACTION_EVERY_STEPS steps on long-horizon
# tasks, and the planner then sees the summary + last 2 history
# entries instead of the full history.
PRIVAGENT_MAX_STEPS=50
PRIVAGENT_MAX_LONG_STEPS=100
PRIVAGENT_COMPACTION_EVERY_STEPS=25
# Memory recall into the planner prompt: at most this many facts /
# skills, and at most this many characters of facts in total.
PRIVAGENT_MEMORY_RECALL_FACTS=5
PRIVAGENT_MEMORY_RECALL_SKILLS=2
PRIVAGENT_MEMORY_RECALL_MAX_CHARS=800
# Scheduler tick: how often the in-process runner claims due jobs.
PRIVAGENT_SCHEDULER_TICK_S=30
# Off by default: screenshots stay on-device. Set true only if you accept
# sending a rendered page image to the remote model provider.
ALLOW_SCREENSHOTS=false

# DeepAI Gateway (Local OpenAI-compatible gateway for DeepSeek & free models)
DEEPAI_GATEWAY_BASE_URL=http://127.0.0.1:8787/v1
DEEPAI_GATEWAY_KEY=
DEEPAI_GATEWAY_MODEL=deepseek-v4.1-flash

# --- Perception limits (Task 7) ---
# How much of the page the planner sees per observation. Bigger context
# costs more tokens per step (slower + pricier on metered providers);
# lower these if latency or cost matters more than coverage.
PRIVAGENT_MAX_ELEMENTS=200
PRIVAGENT_MAX_PAGE_TEXT_CHARS=8000
PRIVAGENT_MAX_INSTRUCTION_CHARS=8000
PRIVAGENT_MAX_AX_NODES=300
# OCR over screenshots (Task 7): disabled by default, and gated on
# ALLOW_SCREENSHOTS above. Requires a system `tesseract` binary
# (apt install tesseract-ocr / brew install tesseract); without it OCR
# is simply unavailable and the planner proceeds text-only.
PRIVAGENT_OCR_ENABLED=false
PRIVAGENT_OCR_MAX_CHARS=2000

# --- Generalisation (Task 8) ---
# Advisory site hints (prose only, never selectors) for a handful of
# domains. Set false to run in pure-general mode — the agent must work
# from the AX tree alone. See docs/GENERALISATION.md.
PRIVAGENT_SITE_HINTS=true

# --- Isolation & injection defence (Task 3) ---
# Domain allow-list for navigation and backend egress (comma-separated;
# "*.example.com" matches subdomains only). Leave empty and task creation
# logs a warning and navigation is unrestricted (back-compat).
PRIVAGENT_ALLOWED_DOMAINS=
# Directory used as Chrome --user-data-dir for agent-only work. Never point
# this at your everyday Chrome profile.
PRIVAGENT_AGENT_PROFILE_DIR=backend/data/agent-profile

# --- Privacy beyond redaction (Task 10) ---
# Local planner (Ollama): run the planner on this machine so no page
# data leaves it. Install Ollama (https://ollama.com), start it with
# `ollama serve`, and pull a model (`ollama pull qwen2.5:7b`). The base
# URL must be loopback — a non-loopback URL is refused. See
# docs/LOCAL_PLANNER.md.
# PRIVAGENT_PLANNER=ollama
PRIVAGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
PRIVAGENT_OLLAMA_MODEL=qwen2.5:7b
# Local-only: the planner chain is ollama -> fail. When Ollama is
# unreachable the task fails honestly; it NEVER silently falls back to
# a cloud provider. Local-first tries Ollama first, then the normal chain.
PRIVAGENT_PLANNER_LOCAL_ONLY=false
PRIVAGENT_PLANNER_LOCAL_FIRST=false
# Zero retention: no checkpoints, no screenshots to the planner, pruned
# in-memory history, silenced provider telemetry. A zero-retention task
# cannot be resumed after a restart. See docs/PRIVACY.md.
PRIVAGENT_ZERO_RETENTION=false
PRIVAGENT_ZERO_RETENTION_HISTORY_KEEP=3
# Audit log (append-only, hash-chained) location. Defaults to
# backend/data/audit.log; dir 0700, file 0600.
# PRIVAGENT_AUDIT_LOG_PATH=backend/data/audit.log
