GEMINI_API_KEY=
GROQ_API_KEY=
# groq | gemini | mock. Default is explicit mock for a no-key local run;
# /api/health reports requestedProvider, provider and providerFallback.
NAVIGATOR_PROVIDER=mock
# Optional primary-model overrides (defaults: gemini-3.8-flash / openai/gpt-oss-120b)
GEMINI_MODEL=
GROQ_MODEL=
MAX_STEPS=25
MAX_RETRIES=3
TASK_TIMEOUT_S=360
# Off by default: screenshots stay on-device. Set true only if you accept
# sending a rendered page image to the remote model provider.
ALLOW_SCREENSHOTS=false

